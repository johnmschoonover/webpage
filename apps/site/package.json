    "@astrojs/sitemap": "^3.7.4",
    "@tailwindcss/vite": "^4.3.3",
    "@keystatic/astro": "^6.0.0",
    "@keystatic/core": "^0.6.9",
    "@radix-ui/react-slot": "^1.4.0",
    "@tailwindcss/typography": "^0.5.20",
    "astro": "^7.3.8",
    "autoprefixer": "^10.6.1",
    "chart.js": "^4.5.1",
    "class-variance-authority": "^0.7.1",
