# Environment template for theschoonover.net
# Copy this file to `.env` and fill in the values before running the site locally or deploying.

# -----------------------------------------------------------------------------
# Core site configuration
# -----------------------------------------------------------------------------
# Public URL where the site is hosted. Use the local dev server URL when running locally.
SITE_URL=http://localhost:4321

# Optional display name for transactional emails.
SITE_NAME=theschoonover.net

# -----------------------------------------------------------------------------
# Contact form delivery (Resend HTTP API)
# -----------------------------------------------------------------------------
# Set these as Cloudflare Pages variables. RESEND_API_KEY must be an encrypted secret.
# The API route reads them at request time through getRuntimeEnv(); they are never
# read from import.meta.env, so local `pnpm dev` skips sending and only logs.
# Resend API key with "Sending access" scoped to theschoonover.net.
RESEND_API_KEY=
# Optional. Recipient for submissions. Defaults to email_public in data/profile.json.
CONTACT_TO=
# Optional. Sender; must be on a domain verified in Resend.
# Defaults to "theschoonover.net contact form <contact@theschoonover.net>".
CONTACT_FROM=

# -----------------------------------------------------------------------------
# Cloudflare Turnstile (required in production; the form fails closed without it)
# -----------------------------------------------------------------------------
# Both are read at request time through getRuntimeEnv(), so local `pnpm dev` shows no
# widget and skips verification. For `wrangler pages dev`, use Cloudflare's test keys
# (always passes: 1x00000000000000000000AA / 1x0000000000000000000000000000000AA).
# Public widget site key. Plain-text var in the root wrangler.toml [vars].
TURNSTILE_SITE_KEY=
# Widget secret. Encrypted secret in Cloudflare Pages (Production and Preview).
TURNSTILE_SECRET_KEY=

# -----------------------------------------------------------------------------
# Plausible Analytics (optional)
# -----------------------------------------------------------------------------
# Enable Plausible analytics tracking script when set to "true".
PLAUSIBLE_ENABLED=false
# Base domain you want Plausible to track (usually matches SITE_URL host).
PLAUSIBLE_DOMAIN=theschoonover.net
# Host serving the Plausible script. Use your self-hosted domain or https://plausible.io.
PLAUSIBLE_SCRIPT_HOST=https://plausible.io
# Optional API host for the Plausible event endpoint.
PLAUSIBLE_API_HOST=https://plausible.io

# -----------------------------------------------------------------------------
# Logging & diagnostics (optional)
# -----------------------------------------------------------------------------
# One of: debug, info, warn, error. Defaults to info if unset.
LOG_LEVEL=info
# Optional Sentry/monitoring DSN placeholder if instrumentation is added later.
SENTRY_DSN=
